{
  "name": "marketing-intelligence-platform",
  "version": "0.1.0",
  "description": "Multi-tenant marketing analytics MVP (Next.js + Supabase + BigQuery). Local-only Phase 1.",
  "scripts": {
    "dev": "next dev -H 127.0.0.1 -p 3000",
    "build": "next build",
    "start": "next start -H 127.0.0.1 -p 3000",
    "worker": "tsx --env-file=.env.local src/worker/index.ts",
    "worker:once": "tsx --env-file=.env.local src/worker/index.ts --once",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:integration": "vitest run -c vitest.integration.config.ts",
    "test:e2e": "node --env-file=.env.local tests/e2e/run-e2e.mjs",
    "test:all": "npm run typecheck && npm test && npm run test:integration && npm run check:secrets",
    "check:secrets": "node scripts/check-secrets.mjs",
    "check:bundle": "node scripts/check-secrets.mjs --bundle",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "env:local": "node scripts/write-local-env.mjs"
  },
  "license": "MIT",
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.5",
    "@types/node": "^26.6.6",
    "@types/papaparse": "^5.5.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "postcss": "^8.5.33",
    "supabase": "^3.2.0",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "typescript": "5.9",
    "vitest": "^5.1.1"
  },
  "dependencies": {
    "@google-cloud/bigquery": "^9.6.1",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.119.2",
    "@vercel/oidc": "^4.0.9",
    "google-auth-library": "^11.3.4",
    "next": "^16.4.6",
    "papaparse": "^5.7.1",
    "pg": "^8.23.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  }
}
