# Copy to .env.local (git-ignored) or run `npm run env:local` after `npm run db:start`.
# NEVER commit real values. Server-only variables have no NEXT_PUBLIC_ prefix.

APP_URL=http://127.0.0.1:3000

# Supabase (local: values printed by `npx supabase status`)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# server only — bypasses RLS; used only after server-side authorization checks
SUPABASE_SERVICE_ROLE_KEY=
# server/worker only — direct Postgres connection
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
MAILPIT_URL=http://127.0.0.1:54324

# Warehouse: "local" (simulated, no Google account needed) or "bigquery" (real)
WAREHOUSE_MODE=local
WAREHOUSE_LOCAL_URL=postgresql://postgres:postgres@127.0.0.1:54322/mip_warehouse
DATASET_PREFIX=mip_dev

# Real BigQuery mode (uses Application Default Credentials; no key files in the repo)
BIGQUERY_PROJECT_ID=
BIGQUERY_LOCATION=US
# Must be set to true by the project owner AFTER approving billing. Otherwise no dataset is created.
BIGQUERY_BILLING_APPROVED=false
# Per-query cap; queries over the cap fail without charge (see docs/COSTS.md)
BIGQUERY_MAX_BYTES_BILLED=104857600
BIGQUERY_DATASETS_PER_PROJECT=500

# base64 of 32 random bytes: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TOKEN_ENCRYPTION_KEY=

# Google OAuth (GA4 + Google Ads live connectors). Leave empty to use only CSV / sample data.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://127.0.0.1:3000/api/oauth/google/callback
GOOGLE_ADS_API_VERSION=v26
# Optional (see docs/CONNECTORS.md — Google's developer-token page says tokens were sunset on 2026-09-09)
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_LOGIN_CUSTOMER_ID=

INITIAL_BACKFILL_DAYS=30
